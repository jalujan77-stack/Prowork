	var xogInput, xogResult, CodeMirrorOut;
		require(["ext/codemirror/codemirror", "ext/csslint/csslint", "ext/codemirror/addon/lint", "ext/codemirror/mode/css", "ext/codemirror/mode/xml", "ext/codemirror/mode/javascript", "ext/codemirror/mode/htmlmixed"
			], function (CodeMirror) {
			CodeMirrorOut = CodeMirror;
			var xmlInput = document.getElementById("xog_in");
			var xmlResult = document.getElementById("xog_result");
			var cm = {
				mode: "text/xml",
				lineNumbers: true,
				matchBrackets: true,
				gutters: ["CodeMirror-lint-markers"],
				indentUnit:4,
				lint: false
			};
			var cm2 = {
				mode: "text/xml",
				lineNumbers: true,
				matchBrackets: true,
				gutters: ["CodeMirror-lint-markers"],
				indentUnit:4,
				readOnly:true,
				lint: false
			};		
			xogInput = CodeMirror.fromTextArea(xmlInput,  cm );
			xogResult = CodeMirror.fromTextArea(xmlResult, cm2);
			//xogInput.setSize(500,300);
		})		
		
		
	var texto = '';

	function addSampleCode(type){
		muestra_oculta('divoutput',false);
		xogResult.setValue('');
		texto = samples[type]==undefined?'':''+samples[type];
		xogInput.setValue(texto);
	}

	function muestra_oculta(id, valorVar){
		if (valorVar){
			if (document.getElementById){ 
				var el = document.getElementById(id); 
				el.style.display ='block'; 
			}
		}else {
			if (document.getElementById){
				var el = document.getElementById(id); 
				el.style.display = 'none';
			}
		}
	}

	muestra_oculta('divoutput',false);

	function openAlert() {
		var ALERT_MODAL_CONTENT =
		  '<div class="ppm_dialog" style="width: 500px;height: auto; z-index: 103;position: fixed;top: 50%;left: 50%;transform: translate(-50%, -50%);" id="ppm_dialog_xog">' +
		  '<div class="ppm_dialog_inner ppm_workspace_bg">' +
		  '<div class="ppm_portlet_title_bar" style="height: auto;">' +
		  '<h1 class="ppm_workspace_title" style="font-weight: bold;">Message</h1>' +
		  '</div>' +
		  '<div class="ppm_portlet" style="padding: 15px; font-size: 12px; font-weight: initial; margin: 0px;">' +
		  '<p style="padding: 10px;">Espera mientras se procesa la acción</p>' +
		  '</div>' +
		  '</div>' +
		  '</div>';

		jQuery("#ppm_app").append(ALERT_MODAL_CONTENT);
		jQuery("#ppm_app").append('<div class="ppm_modal_mask" style="z-index:102;" id="ppm_modal_mask_xog"></div>');
	};

	function closeAlert() {
		jQuery("#ppm_dialog_xog").remove();
		jQuery("#ppm_modal_mask_xog").remove();
	}

	function comprobarCabecera(textoParseo){
		parser = new DOMParser();
		doc = parser.parseFromString(textoParseo, "application/xml");
		textoConsola = doc.getElementsByTagName("Header")[0];
		return textoConsola.getAttribute("action")
	}

	var textoConsola;
	var doc;
	function xogExec() {
		xogResult.setValue('');
		var textoEscribir = xogInput.getValue();

		if(textoEscribir.includes('<?xml version="1.0" encoding="UTF-8"?>')){
			textoEscribir2 = textoEscribir.replace('<?xml version="1.0" encoding="UTF-8"?>\n','');
			xogInput.setValue(textoEscribir2.toString());
			textoEscribir = xogInput.getValue();   	
		}
		xogInput.setValue(textoEscribir.toString());		
		/*if (comprobarCabecera(textoEscribir.toString()) == 'write'){
			muestra_oculta('xog_result',false);
		} else {
			muestra_oculta('xog_result',true);
		}*/

		var soapURL = window.location.protocol + '//' + window.location.host + '/niku/xog';
		var request =
		  '<?xml version="1.0" encoding="utf-8" ?>' +
		  '<soapenv:Envelope xmlns:obj="http://www.niku.com/xog" xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/">' +
		  '  <soapenv:Header>' +
		  '    <obj:Auth>' +
		  '      <obj:SessionID>' + sessionID + '</obj:SessionID>' +
		  '    </obj:Auth>' +
		  '  </soapenv:Header>' +
		  '  <soapenv:Body>' + textoEscribir + '</soapenv:Body>' +
		  '</soapenv:Envelope>';

		jQuery("#xog_result").val(null);
		jQuery("#xog_output").val(null);

		var xmlhttp = new XMLHttpRequest();

		openAlert();

		xmlhttp.onreadystatechange = function() {
		  if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
			var xmlDoc = xmlhttp.responseXML;
			try {
			  var xogOutput = xmlDoc.getElementsByTagName("XOGOutput")[0];
			  if(typeof xogOutput == 'undefined') {
				jQuery("#xog_output").val('');
			  } else {
				jQuery("#xog_output").val(new XMLSerializer().serializeToString(xogOutput));
				xogOutput.parentNode.removeChild(xogOutput);
			  }

			  var xogResultPet = xmlDoc.getElementsByTagName("NikuDataBus")[0];
				xogResult.setValue(new XMLSerializer().serializeToString(xogResultPet));
				xogResult.save();
			  
			} catch (err) {
			  console.log(err.message);
			  closeAlert();
			}
			muestra_oculta('divoutput',true);
			closeAlert();		
		  }
		}

		xmlhttp.open('POST', soapURL, true);
		xmlhttp.setRequestHeader("Content-Type", "text/xml");
		xmlhttp.send(request);
	}
</script>
