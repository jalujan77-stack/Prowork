	var xmlHttpSessionID = new XMLHttpRequest();
	xmlHttpSessionID.open('POST', window.location.protocol + '//' + window.location.host + '/niku/xog', false);
	xmlHttpSessionID.setRequestHeader("Content-Type", "text/xml;charset=UTF-8");
	xmlHttpSessionID.setRequestHeader("SOAPAction", "");
	xmlHttpSessionID.send(loginSoap);

	if (xmlHttpSessionID.status == 200) {
		var xmlDoc = xmlHttpSessionID.responseXML;
		var sessNode = xmlDoc.getElementsByTagName("SessionID")[0];
		if (sessNode) {
			sessionID = sessNode.textContent || sessNode.innerText;
			console.log('SessionID obtenido:', sessionID);
		} else {
			console.error('Login XOG fallido:', xmlHttpSessionID.responseText);
		}
